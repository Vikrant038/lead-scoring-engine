{
  "name": "lead-scoring-engine",
  "version": "1.0.0",
  "description": "Lead Scoring Engine (ICP Profiler) — modular, multi-user lead qualification system",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/src/cli/index.js",
  "scripts": {
    "build": "npm run build:css && tsc -p tsconfig.json",
    "build:css": "tailwindcss -i ./src/web/views/styles.css -o ./public/css/app.css --minify",
    "start": "node dist/src/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "server": "node dist/src/web/server.js",
    "dev:server": "tsx src/web/server.ts",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "jest",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.20",
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-sqlite3": "^0.9.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-plugin-compat": "^6.0.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.11",
    "msw": "^2.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "tar": "^7.4.3",
    "cacache": "^19.0.0",
    "esbuild": "^0.25.0",
    "@tootallnate/once": "^2.0.1",
    "js-yaml": "^4.1.1"
  }
}
