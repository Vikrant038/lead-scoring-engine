{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{node_modules/@better-auth/**,node_modules/better-auth/**,node_modules/better-sqlite3/**,src/web/views/**,data/**,public/**,docs/**}"
    }
  },
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/public/js/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
