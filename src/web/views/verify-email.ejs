<!doctype html>
<html lang="en" class="">
  <head>
    <%- include('partials/head') %>
    <title>Verify Email — ICP Profiler</title>
    <style>
      .auth-bg {
        background-color: #030712;
        background-image:
          radial-gradient(at 0% 0%, hsla(244, 50%, 15%, 0.4) 0px, transparent 50%),
          radial-gradient(at 100% 100%, hsla(224, 50%, 10%, 0.3) 0px, transparent 50%),
          linear-gradient(to bottom right, #030712, #0b0f19);
      }
      .auth-grid {
        background-size: 40px 40px;
        background-image:
          linear-gradient(to right, rgba(0, 41, 255, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 41, 255, 0.04) 1px, transparent 1px);
      }
      .card-glass {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .animate-fadeUp { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-8px); }
      }
      .animate-float { animation: float 4s ease-in-out infinite; }
      .input-field {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        color: #f1f5f9;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .input-field:focus {
        outline: none;
        border-color: #0029ff;
        box-shadow: 0 0 0 3px rgba(0, 41, 255, 0.15);
      }
      .input-field::placeholder { color: rgba(148, 163, 184, 0.3); }
      .btn-primary {
        background: linear-gradient(135deg, #0029ff, #0018c0);
        color: white;
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      }
      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(0, 41, 255, 0.35);
        opacity: 0.95;
      }
      .btn-primary:active { transform: translateY(0); }
      .code-input {
        letter-spacing: 1.5em;
        padding-left: 1.75em;
      }
    </style>
  </head>
  <body class="auth-bg min-h-screen flex items-center justify-center p-4">
    <div class="absolute inset-0 auth-grid pointer-events-none"></div>

    <!-- Decorative blobs -->
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-[#0029ff]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative w-full max-w-md animate-fadeUp">
      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img src="/luxury-hero.png" alt="ICP Profiler" class="w-10 h-10 rounded-xl object-cover animate-float shadow-lg shadow-[#0029ff]/20" />
          <span class="text-2xl font-bold text-white tracking-tight">ICP Profiler</span>
        </a>
        <p class="mt-2 text-slate-400 text-sm">AI-powered lead intelligence</p>
      </div>

      <div class="card-glass rounded-2xl p-8 shadow-2xl">
        <h1 class="text-xl font-bold text-white mb-1 font-sans">Verify your email</h1>
        <p class="text-slate-400 text-sm mb-6">We have sent a 6-digit verification code to <span class="text-slate-200 font-semibold"><%= email %></span></p>

        <% if (error) { %>
          <div class="mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <%= error %>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="mb-5 px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <%= success %>
          </div>
        <% } %>

        <form method="POST" action="/auth/verify-email" id="verify-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="email" value="<%= email %>" />

          <div>
            <label for="code" class="block text-center text-sm font-medium text-slate-300 mb-3">6-Digit Verification Code</label>
            <input
              id="code"
              name="code"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              required
              placeholder="000000"
              class="input-field code-input w-full px-4 py-3 rounded-xl text-xl font-mono text-center"
            />
          </div>

          <button type="submit" id="verify-btn" class="btn-primary mt-6 w-full py-2.5 px-4 rounded-xl text-sm font-semibold">
            Verify & Continue
          </button>
        </form>

        <div class="mt-8 text-center text-sm text-slate-400">
          Didn't receive the code?
          <form method="POST" action="/auth/verify-email/resend" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="email" value="<%= email %>" />
            <button type="submit" class="text-[#0029ff] hover:text-blue-400 font-medium transition-colors cursor-pointer bg-transparent border-none p-0 inline align-baseline">
              Resend Code
            </button>
          </form>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-slate-600">
        &copy; <%= new Date().getFullYear() %> ICP Profiler. Built with ❤️ as a portfolio project.
      </p>
    </div>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      // Auto-focus on the code field
      document.getElementById('code')?.focus();
    </script>
  </body>
</html>
