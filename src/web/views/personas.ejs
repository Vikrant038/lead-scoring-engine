<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <style>
      .animate-pulse-subtle {
        animation: pulse-subtle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }
      @keyframes pulse-subtle {
        0%, 100% {
          opacity: 1;
          transform: scale(1);
        }
        50% {
          opacity: .85;
          transform: scale(0.98);
        }
      }
      .modal-backdrop {
        transition: opacity 300ms ease-out;
      }
      .modal-content {
        transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease-out;
      }
      /* Initial card state for fade-in stagger */
      .persona-card {
        opacity: 0;
        transform: translateY(16px);
        transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), opacity 500ms ease-out;
      }
      /* Custom dark scrollbar for example panes */
      .scrollbar-thin::-webkit-scrollbar {
        width: 6px;
      }
      .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
      }
      .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.3);
        border-radius: 9999px;
      }
      .dark .scrollbar-thin::-webkit-scrollbar-thumb {
        background-color: rgba(75, 85, 99, 0.5);
      }
      .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background-color: rgba(156, 163, 175, 0.5);
      }
      .dark .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background-color: rgba(75, 85, 99, 0.7);
      }
      /* Firefox scrollbar styles */
      .scrollbar-thin {
        scrollbar-width: thin;
        scrollbar-color: rgba(156, 163, 175, 0.3) transparent;
      }
      .dark .scrollbar-thin {
        scrollbar-color: rgba(75, 85, 99, 0.5) transparent;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-150 flex flex-col min-h-screen" data-selected-persona="<%= selectedPersona %>">
    <%- include('partials/header', { activePersonaName: activePersonaName, csrfToken: csrfToken, cspNonce: typeof cspNonce !== 'undefined' ? cspNonce : '' }) %>
    
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
      
      <!-- Top Action Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-black text-gray-900 dark:text-white tracking-tight">Personas</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Manage target customer profiles, search priorities, and lead-scoring rules.</p>
        </div>
        <button id="open-upload-modal-btn" type="button" aria-label="Add a new persona config" class="inline-flex items-center gap-2 px-5 py-2.5 border border-[#0029ff] dark:border-blue-500 text-[#0029ff] dark:text-blue-400 hover:bg-[#0029ff] dark:hover:bg-blue-500 hover:text-white dark:hover:text-white text-xs font-bold rounded-xl transition-all duration-150 hover:scale-105 active:scale-95">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Upload New Persona
        </button>
      </div>

      <!-- Personas Card Grid -->
      <% if (personas.length === 0) { %>
        <div class="bg-white dark:bg-gray-900 border border-gray-250/80 dark:border-gray-800 rounded-3xl p-12 text-center shadow-sm">
          <svg class="w-12 h-12 text-gray-400 dark:text-gray-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <p class="text-sm text-gray-500 dark:text-gray-400 font-semibold">No personas yet. Upload one above to get started.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="personas-grid">
          <% personas.forEach(function (p, index) { %>
            <% const isActive = p.id === selectedPersona; %>
            <div 
              class="persona-card bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md hover:border-gray-300 dark:hover:border-gray-700 transition-all duration-300"
              style="transition-delay: <%= index * 75 %>ms"
              data-id="<%= p.id %>"
            >
              <div>
                <!-- Card Header -->
                <div class="flex items-start justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <input
                      type="radio"
                      name="active-persona"
                      class="set-persona w-5 h-5 text-[#0029ff] border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-850 focus:ring-[#0029ff] focus:ring-offset-0 cursor-pointer"
                      value="<%= p.id %>"
                      <%= isActive ? 'checked' : '' %>
                      aria-label="Set <%= p.name %> as active persona"
                    />
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white leading-snug truncate"><%= p.name %></h3>
                  </div>
                  <% if (isActive) { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-50 dark:bg-emerald-950/30 text-emerald-600 dark:text-emerald-400 border border-emerald-100 dark:border-emerald-900/30 animate-pulse-subtle flex-shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Active
                    </span>
                  <% } %>
                </div>
                
                <!-- Card Body -->
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-6 line-clamp-3"><%= p.description %></p>
              </div>

              <!-- Card Footer Actions -->
              <div>
                <div class="border-t border-gray-100 dark:border-gray-800/80 pt-4 mb-4 flex items-center justify-between text-xs text-gray-400 dark:text-gray-500">
                  <span>Last modified</span>
                  <span class="font-medium"><%= new Date(p.lastModified).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>

                <div class="flex items-center gap-2 mt-auto">
                  <% if (!isActive) { %>
                    <button type="button" class="set-active-btn flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-800 hover:bg-[#0029ff] dark:hover:bg-[#0029ff] hover:text-white dark:hover:text-white text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl transition duration-150 hover:scale-105 active:scale-95" data-id="<%= p.id %>">
                      Set Active
                    </button>
                  <% } %>
                  <a href="/personas/<%= p.id %>/edit" class="edit-persona-btn <%= isActive ? 'flex-1' : '' %> px-3 py-2 border border-gray-200 dark:border-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 text-xs font-bold rounded-xl transition duration-150 hover:scale-105 active:scale-95 text-center flex items-center justify-center" data-id="<%= p.id %>">
                    Edit
                  </a>
                  <button type="button" class="delete-persona-btn px-3 py-2 border border-red-250/20 dark:border-red-900/30 text-red-650 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/20 text-xs font-bold rounded-xl transition duration-150 hover:scale-105 active:scale-95" data-id="<%= p.id %>">
                    Delete
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </main>

    <!-- Upload Modal -->
    <div id="upload-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden pointer-events-none opacity-0" role="dialog" aria-modal="true" aria-labelledby="upload-modal-title" aria-hidden="true">
      <!-- Backdrop -->
      <div class="absolute inset-0 bg-gray-950/40 dark:bg-black/60 backdrop-blur-sm opacity-0 modal-backdrop"></div>
      
      <!-- Content Container -->
      <div class="relative w-full max-w-lg bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-3xl p-6 shadow-2xl scale-95 opacity-0 pointer-events-auto modal-content transition-all duration-300">
        <div class="flex items-center justify-between mb-4">
          <h2 id="upload-modal-title" class="text-xl font-bold text-gray-900 dark:text-white">Add New Persona</h2>
          <button type="button" class="close-modal-btn p-1.5 rounded-lg text-gray-400 dark:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition duration-150" aria-label="Close modal">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="grid grid-cols-1 gap-6" id="modal-grid-layout">
          <!-- Left side: Creation Form and File Upload -->
          <div class="space-y-4" id="modal-form-side">
            <!-- Creation Form -->
            <form id="create-persona-form" class="space-y-3.5">
              <div>
                <label class="block text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Persona Name <span class="text-red-500">*</span></label>
                <input type="text" id="new-persona-name" required class="w-full bg-white dark:bg-gray-955 border border-gray-200 dark:border-gray-850 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0029ff] focus:border-transparent transition-all" placeholder="e.g. CTO or Technical Lead" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Description <span class="text-red-500">*</span></label>
                <textarea id="new-persona-desc" required rows="2" class="w-full bg-white dark:bg-gray-955 border border-gray-200 dark:border-gray-850 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0029ff] focus:border-transparent transition-all" placeholder="Target criteria for lead match..."></textarea>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Unique Persona ID (filename slug)</label>
                <input type="text" id="new-persona-id" required class="w-full bg-white dark:bg-gray-955 border border-gray-200 dark:border-gray-850 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-[#0029ff] focus:border-transparent transition-all" placeholder="e.g. cto" />
              </div>
              <button id="create-persona-submit-btn" type="submit" class="w-full py-3 bg-[#0029ff] text-white text-xs font-bold rounded-xl hover:bg-[#0021cc] active:bg-[#001999] shadow-sm shadow-[#0029ff]/10 transition duration-150">
                Create & Customize Form
              </button>
            </form>

            <!-- Toggle Example Option -->
            <label for="toggle-example-btn" class="flex items-center justify-between py-2.5 px-3 bg-gray-50/50 dark:bg-gray-950/20 border border-gray-150 dark:border-gray-850 rounded-xl mt-3 cursor-pointer select-none hover:bg-gray-100/50 dark:hover:bg-gray-800/50 transition duration-150">
              <div class="flex items-center gap-2 pointer-events-none">
                <svg class="w-4 h-4 text-gray-400 dark:text-gray-550 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Show Example Config</span>
              </div>
              <div class="flex items-center pointer-events-none">
                <input type="checkbox" id="toggle-example-btn" class="sr-only peer" />
                <div class="relative w-9 h-5 bg-gray-200 dark:bg-gray-800 rounded-full peer peer-focus:ring-0 peer-checked:bg-[#0029ff] after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
              </div>
            </label>

            <!-- Divider -->
            <div class="relative flex py-1 items-center">
              <div class="flex-grow border-t border-gray-150 dark:border-gray-800"></div>
              <span class="flex-shrink mx-4 text-[9px] text-gray-400 dark:text-gray-500 font-black uppercase tracking-wider">Or upload JSON configuration</span>
              <div class="flex-grow border-t border-gray-150 dark:border-gray-800"></div>
            </div>

            <!-- File Upload Dropzone -->
            <div id="persona-dropzone" class="border-2 border-dashed border-gray-250/80 dark:border-gray-800 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-gray-50/50 dark:bg-gray-950/20 cursor-pointer hover:border-[#0029ff] dark:hover:border-blue-500 transition duration-150">
              <svg class="w-8 h-8 text-gray-400 dark:text-gray-550 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-3-3v6m-9 1V4a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
              </svg>
              <span id="dropzone-text" class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Click to select or drag JSON file here</span>
              <span id="selected-filename" class="text-[10px] text-gray-400 dark:text-gray-500 truncate max-w-[220px]">No file chosen</span>
              <input id="persona-file" type="file" accept="application/json,.json" style="display: none;" />
            </div>
            
            <button id="upload-btn" type="button" class="w-full py-2.5 border border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-850 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl transition duration-150">
              Upload JSON File
            </button>
            <p id="upload-status" class="text-xs font-semibold text-center mt-2 hidden" role="status"></p>
          </div>

          <!-- Right side: Concrete Example Container (hidden by default) -->
          <div id="example-panel" class="border border-gray-250/80 dark:border-gray-800 rounded-2xl p-4 bg-gray-50/50 dark:bg-gray-950/20 flex flex-col h-full hidden">
            <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-800 pb-3 mb-3">
              <span class="text-xs font-bold text-gray-900 dark:text-white">Example Persona Config</span>
              <!-- Tabs or Toggle buttons -->
              <div class="flex bg-gray-150 dark:bg-gray-800 rounded-lg p-0.5" role="tablist">
                <button type="button" id="example-tab-form" class="px-2.5 py-1 text-[10px] font-bold rounded-md bg-white dark:bg-gray-900 shadow-sm text-gray-900 dark:text-white transition-all duration-150" role="tab" aria-selected="true">Form Format</button>
                <button type="button" id="example-tab-json" class="px-2.5 py-1 text-[10px] font-bold rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-all duration-150" role="tab" aria-selected="false">JSON Format</button>
              </div>
            </div>

            <!-- Form format example pane -->
            <div id="example-pane-form" class="space-y-4 text-xs overflow-y-auto max-h-[480px] scrollbar-thin">
              <div class="space-y-3">
                <div>
                  <p class="text-[10px] font-bold text-gray-400 dark:text-gray-550 uppercase tracking-wider mb-1">Basic Info</p>
                  <div class="bg-white dark:bg-gray-900 border border-gray-250/60 dark:border-gray-800 rounded-xl p-3 space-y-1">
                    <div class="flex justify-between"><span class="text-gray-500">Name</span><span class="font-bold text-gray-900 dark:text-white">CTO</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Description</span><span class="font-medium text-gray-700 dark:text-gray-300 text-right">Technical decision makers</span></div>
                  </div>
                </div>
                <div>
                  <p class="text-[10px] font-bold text-gray-400 dark:text-gray-550 uppercase tracking-wider mb-1">Scoring Weights</p>
                  <div class="bg-white dark:bg-gray-900 border border-gray-250/60 dark:border-gray-800 rounded-xl p-3 flex justify-between gap-2">
                    <div class="text-center flex-1">
                      <span class="block text-[10px] text-gray-400 dark:text-gray-550">Education</span>
                      <span class="font-bold text-gray-900 dark:text-white">0.2</span>
                    </div>
                    <div class="text-center flex-1 border-x border-gray-100 dark:border-gray-800">
                      <span class="block text-[10px] text-gray-400 dark:text-gray-550">Experience</span>
                      <span class="font-bold text-gray-900 dark:text-white">0.5</span>
                    </div>
                    <div class="text-center flex-1">
                      <span class="block text-[10px] text-gray-400 dark:text-gray-550">Thinking</span>
                      <span class="font-bold text-gray-900 dark:text-white">0.3</span>
                    </div>
                  </div>
                </div>
                <div>
                  <p class="text-[10px] font-bold text-gray-400 dark:text-gray-550 uppercase tracking-wider mb-1">Education Criteria</p>
                  <div class="bg-white dark:bg-gray-900 border border-gray-250/60 dark:border-gray-800 rounded-xl p-3">
                    <div class="flex flex-wrap gap-1.5 items-center">
                      <span class="text-gray-500 mr-2">Preferred Tiers:</span>
                      <span class="px-2 py-0.5 bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 border border-indigo-100/50 dark:border-indigo-900/30 rounded-md font-bold text-[10px]">Tier 1</span>
                      <span class="px-2 py-0.5 bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 border border-indigo-100/50 dark:border-indigo-900/30 rounded-md font-bold text-[10px]">Tier 2</span>
                    </div>
                  </div>
                </div>
                <div>
                  <p class="text-[10px] font-bold text-gray-400 dark:text-gray-550 uppercase tracking-wider mb-1">Experience Criteria</p>
                  <div class="bg-white dark:bg-gray-900 border border-gray-250/60 dark:border-gray-800 rounded-xl p-3 space-y-2">
                    <div class="flex justify-between items-center"><span class="text-gray-500">Min Experience</span><span class="font-bold text-gray-900 dark:text-white">8 years</span></div>
                    <div>
                      <span class="text-gray-500 block mb-1">Must Include Roles:</span>
                      <div class="flex flex-wrap gap-1.5">
                        <span class="px-2 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30 rounded-md font-bold text-[10px]">CTO</span>
                        <span class="px-2 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30 rounded-md font-bold text-[10px]">Chief Technology Officer</span>
                        <span class="px-2 py-0.5 bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30 rounded-md font-bold text-[10px]">VP Engineering</span>
                      </div>
                    </div>
                    <div>
                      <span class="text-gray-500 block mb-1">Preferred Company Tiers:</span>
                      <div class="flex flex-wrap gap-1.5">
                        <span class="px-2 py-0.5 bg-indigo-50 dark:bg-indigo-950/30 text-indigo-600 dark:text-indigo-400 border border-indigo-100/50 dark:border-indigo-900/30 rounded-md font-bold text-[10px]">Tier 1</span>
                      </div>
                    </div>
                  </div>
                </div>
                <div>
                  <p class="text-[10px] font-bold text-gray-400 dark:text-gray-550 uppercase tracking-wider mb-1">Skills Criteria</p>
                  <div class="bg-white dark:bg-gray-900 border border-gray-250/60 dark:border-gray-800 rounded-xl p-3">
                    <div class="flex flex-wrap gap-1.5">
                      <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 border border-amber-100/50 dark:border-amber-900/30 rounded-md font-bold text-[10px]">Architect</span>
                      <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 border border-amber-100/50 dark:border-amber-900/30 rounded-md font-bold text-[10px]">Scalability</span>
                      <span class="px-2 py-0.5 bg-amber-50 dark:bg-amber-950/30 text-amber-600 dark:text-amber-400 border border-amber-100/50 dark:border-amber-900/30 rounded-md font-bold text-[10px]">System Design</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- JSON format example pane -->
            <div id="example-pane-json" class="hidden text-[10px] font-mono bg-gray-50 dark:bg-gray-950 text-gray-800 dark:text-gray-200 rounded-xl border border-gray-200 dark:border-gray-800 p-3 overflow-y-auto max-h-[480px] scrollbar-thin">
              <pre class="block leading-relaxed"><code>{
  "name": "CTO",
  "description": "Technical decision makers",
  "weights": {
    "education": 0.2,
    "experience": 0.5,
    "thinking": 0.3
  },
  "education": {
    "preferred_tiers": ["tier_1", "tier_2"]
  },
  "experience": {
    "roles_must_include": ["CTO", "Chief Technology Officer", "VP Engineering"],
    "preferred_companies_tiers": ["tier_1"],
    "min_years_experience": 8
  },
  "skills_must_have": ["Architect", "Scalability", "System Design"]
}</code></pre>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>



    <!-- Delete Modal -->
    <div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden pointer-events-none opacity-0" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title" aria-hidden="true">
      <!-- Backdrop -->
      <div class="absolute inset-0 bg-gray-950/40 dark:bg-black/60 backdrop-blur-sm opacity-0 modal-backdrop"></div>
      
      <!-- Content Container -->
      <div class="relative w-full max-w-md bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/80 rounded-3xl p-6 shadow-2xl scale-95 opacity-0 pointer-events-auto modal-content">
        <div class="flex items-center justify-between mb-4">
          <h2 id="delete-modal-title" class="text-xl font-bold text-gray-900 dark:text-white">Delete Persona?</h2>
          <button type="button" class="close-modal-btn p-1.5 rounded-lg text-gray-400 dark:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition duration-150" aria-label="Close modal">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-6">Are you sure you want to delete this persona? This action moves the configuration file to trash and cannot be undone.</p>
        
        <div class="flex items-center gap-3">
          <button id="confirm-delete-btn" type="button" class="flex-1 py-3 bg-red-650 text-white text-xs font-bold rounded-xl hover:bg-red-750 active:bg-red-800 transition duration-150">
            Confirm Delete
          </button>
          <button type="button" class="close-modal-btn flex-1 py-3 border border-gray-300 dark:border-gray-850 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-gray-50 dark:hover:bg-gray-850 transition duration-150">
            Cancel
          </button>
        </div>
      </div>
    </div>

