<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <style>
      .hero-bg {
        background-color: #ffffff;
        background-image: 
          radial-gradient(at 0% 0%, hsla(224,100%,98%,1) 0px, transparent 50%),
          radial-gradient(at 100% 100%, hsla(220,100%,97%,1) 0px, transparent 50%),
          linear-gradient(to bottom right, #ffffff, #f0f4ff);
      }
      .dark .hero-bg {
        background-color: #030712;
        background-image: 
          radial-gradient(at 0% 0%, hsla(244,50%,15%,0.3) 0px, transparent 50%),
          radial-gradient(at 100% 100%, hsla(224,50%,10%,0.3) 0px, transparent 50%),
          linear-gradient(to bottom right, #030712, #0b0f19);
      }
      .hero-grid {
        background-size: 40px 40px;
        background-image: 
          linear-gradient(to right, rgba(0, 41, 255, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 41, 255, 0.03) 1px, transparent 1px);
      }
      .dark .hero-grid {
        background-image: 
          linear-gradient(to right, rgba(0, 41, 255, 0.015) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 41, 255, 0.015) 1px, transparent 1px);
      }
      @keyframes float {
        0%, 100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }
      .animate-float {
        animation: float 4s ease-in-out infinite;
      }
      .log-entry {
        opacity: 0;
        transform: translateY(4px);
        animation: fadeIn 300ms ease-out forwards;
      }
      @keyframes fadeIn {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes slideInRight {
        from {
          opacity: 0;
          transform: translateX(24px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
      .queue-card-enter {
        animation: slideInRight 350ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-150 flex flex-col min-h-screen" data-poll-interval="<%= pollIntervalMs %>">
    <%
      const activePersonaObj = personas.find(p => p.id === selectedPersona) || personas[0];
      const activePersonaName = activePersonaObj ? activePersonaObj.name : 'Default ICP';
    %>
    <%- include('partials/header', { activePersonaName: activePersonaName, csrfToken: csrfToken, cspNonce: typeof cspNonce !== 'undefined' ? cspNonce : '' }) %>

    <!-- Hero Section -->
    <section class="hero-bg min-h-[calc(100vh-4rem)] flex items-center py-12 md:py-20 relative overflow-hidden">
      <div class="absolute inset-0 hero-grid pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          
          <!-- Left: Hero Text & CTA -->
          <div class="text-left space-y-6">
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-gray-900 dark:text-white leading-tight">
              Transform Your Lead List Into a <span class="text-[#0029ff] dark:text-blue-400">Pipeline</span>
            </h1>
            <p class="text-gray-600 dark:text-gray-400 text-lg md:text-xl max-w-lg leading-relaxed">
              AI‑powered scoring that explains every decision. No black boxes.
            </p>
            <div class="pt-4">
              <button id="cta-button" class="px-8 py-4 bg-[#0029ff] text-white font-bold rounded-full hover:bg-[#0021cc] active:bg-[#001999] shadow-lg shadow-[#0029ff]/20 hover:shadow-xl hover:shadow-[#0029ff]/30 hover:scale-105 active:scale-95 transition-all duration-200">
                Start Scoring Now
              </button>
            </div>
          </div>

          <!-- Right: Floating Hero Image -->
          <div class="flex justify-center lg:justify-end items-center">
            <img src="/luxury-hero.png" alt="ICP Profiler Rocket launching into a digital space" class="w-full max-w-[320px] sm:max-w-[420px] h-auto rounded-3xl shadow-2xl animate-float border border-white/10 dark:border-gray-800" />
          </div>
        </div>
      </div>
    </section>

    <!-- Scoring Area -->
    <section id="scoring-section" class="scroll-smooth bg-slate-50/50 dark:bg-slate-900/10 border-t border-slate-100 dark:border-slate-900 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
          
          <!-- Left Columns (2/3 width): Options and Upload -->
          <div class="lg:col-span-2 space-y-8">
            
            <!-- Persona Selection Dropdown -->
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 md:p-8 shadow-sm">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-blue-50 dark:bg-[#0029ff]/10 text-[#0029ff] dark:text-blue-400 text-sm font-bold">1</span>
                Select Scoring Persona
              </h2>
              
              <div class="mb-2">
                <label id="persona-dropdown-label" class="block text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">Target Profile Type</label>
                <div class="relative w-full max-w-md">
                  <select id="persona-select" class="sr-only" aria-hidden="true">
                    <% personas.forEach(function(persona) { %>
                      <option value="<%= persona.id %>" <%= persona.id === selectedPersona ? 'selected' : '' %>><%= persona.name %></option>
                    <% }); %>
                  </select>
                  <button id="persona-dropdown-button" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="persona-dropdown-label" class="relative w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-800 rounded-xl shadow-sm pl-4 pr-10 py-3.5 text-left cursor-default focus:outline-none focus:ring-2 focus:ring-[#0029ff] focus:border-transparent transition-all duration-200 text-sm font-medium">
                    <span id="selected-persona-text" class="block truncate text-gray-900 dark:text-white"><%= activePersonaName %></span>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-gray-400 dark:text-gray-500">
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </button>

                  <!-- Custom Dropdown List -->
                  <ul id="persona-dropdown-list" role="listbox" aria-labelledby="persona-dropdown-label" class="absolute z-20 mt-1.5 w-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-850 rounded-xl shadow-xl max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-out" tabindex="-1">
                    <% personas.forEach(function(persona) { %>
                      <li id="option-<%= persona.id %>" role="option" aria-selected="<%= persona.id === selectedPersona ? 'true' : 'false' %>" data-value="<%= persona.id %>" data-description="<%= persona.description %>" class="text-gray-700 dark:text-gray-300 cursor-default select-none relative py-3 pl-4 pr-9 hover:bg-blue-50/70 dark:hover:bg-blue-950/70 focus:bg-blue-50 dark:focus:bg-blue-950 focus:outline-none transition duration-150 text-sm font-medium">
                        <span class="block truncate <%= persona.id === selectedPersona ? 'font-semibold text-[#0029ff] dark:text-blue-400' : 'font-normal' %>"><%= persona.name %></span>
                        <% if (persona.id === selectedPersona) { %>
                          <span class="check-icon absolute inset-y-0 right-0 flex items-center pr-3 text-[#0029ff] dark:text-blue-400">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                          </span>
                        <% } %>
                      </li>
                    <% }); %>
                  </ul>
                </div>
              </div>

              <!-- Selected Persona Description -->
              <div class="mt-4 max-w-md">
                <p id="persona-description" class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed bg-gray-50 dark:bg-gray-950 rounded-xl p-4 border border-gray-100 dark:border-gray-900 transition-opacity duration-300">
                  <%= activePersonaObj ? activePersonaObj.description : 'No description available for the active persona.' %>
                </p>
              </div>
            </div>

            <!-- Upload Area -->
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 md:p-8 shadow-sm">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2.5">
                <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-blue-50 dark:bg-[#0029ff]/10 text-[#0029ff] dark:text-blue-400 text-sm font-bold">2</span>
                Upload lead profiles
              </h2>
              
              <div
                id="dropzone"
                tabindex="0"
                role="button"
                aria-label="Upload lead list JSON file"
                class="border-2 border-dashed border-gray-300 dark:border-gray-700 hover:border-[#0029ff] dark:hover:border-blue-500 focus:border-[#0029ff] focus:ring-2 focus:ring-[#0029ff]/20 focus:outline-none rounded-2xl p-10 text-center cursor-pointer bg-white dark:bg-gray-900/50 transition-all duration-200 flex flex-col items-center justify-center group"
              >
                <svg class="w-12 h-12 text-gray-400 dark:text-gray-550 group-hover:text-[#0029ff] dark:group-hover:text-blue-400 group-focus:text-[#0029ff] dark:group-focus:text-blue-400 transition-colors duration-200 mb-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
                </svg>
                <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">Drag and drop your lead list here</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1.5">Only JSON files up to 5MB are accepted</p>
                <input id="file-input" type="file" accept="application/json,.json" class="hidden" />
              </div>
              <p id="upload-error" class="text-red-500 dark:text-red-400 text-xs font-semibold mt-3 flex items-center gap-1.5 hidden" role="alert">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span id="upload-error-text"></span>
              </p>

              <!-- Sample JSON Format -->
              <details class="mt-5 group">
                <summary class="cursor-pointer text-xs font-bold text-[#0029ff] dark:text-blue-400 hover:text-[#0021cc] dark:hover:text-blue-300 transition-colors duration-150 flex items-center gap-1.5 select-none">
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                  What should my JSON look like?
                </summary>
                <div class="mt-3 p-4 bg-gray-50 dark:bg-gray-900/50 rounded-xl border border-gray-200 dark:border-gray-800">
                  <p class="text-[11px] text-gray-500 dark:text-gray-400 mb-3">Upload a JSON array <code class="text-[10px] bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-200 px-1.5 py-0.5 rounded font-mono">[{...}, {...}]</code>. Each entry supports:</p>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold bg-[#0029ff]/10 text-[#0029ff] border border-[#0029ff]/20 dark:bg-blue-950/40 dark:text-blue-400 dark:border-blue-900/30">
                      <span class="w-1 h-1 rounded-full bg-[#0029ff]"></span>name
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold bg-[#0029ff]/10 text-[#0029ff] border border-[#0029ff]/20 dark:bg-blue-950/40 dark:text-blue-400 dark:border-blue-900/30">
                      <span class="w-1 h-1 rounded-full bg-[#0029ff]"></span>current_role
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-bold bg-[#0029ff]/10 text-[#0029ff] border border-[#0029ff]/20 dark:bg-blue-950/40 dark:text-blue-400 dark:border-blue-900/30">
                      <span class="w-1 h-1 rounded-full bg-[#0029ff]"></span>company
                    </span>
                    <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">email</span>
                    <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">experience_years</span>
                    <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">education{}</span>
                    <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">skills[]</span>
                    <span class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">summary</span>
                  </div>
                  <p class="mt-2.5 text-[10px] text-gray-400 dark:text-gray-500">
                    <span class="inline-flex items-center gap-1 mr-1"><span class="w-1 h-1 rounded-full bg-[#0029ff]"></span>Required</span> •
                    Gray = optional
                  </p>
                </div>
              </details>
            </div>

            <!-- Upload/Job Status Container -->
            <div id="job-status-container" class="hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm transition-all duration-300">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span id="job-status-badge" class="px-2.5 py-1 text-xs font-bold rounded-full bg-blue-50 dark:bg-blue-950/30 text-[#0029ff] dark:text-blue-400 uppercase tracking-wider">Processing</span>
                  <span id="job-filename" class="text-xs font-semibold text-gray-500 dark:text-gray-400 truncate max-w-[240px]">leads.json</span>
                </div>
                <!-- Processing Spinner -->
                <div id="job-spinner" class="animate-spin text-[#0029ff] dark:text-blue-400">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </div>
              </div>

              <!-- Animated Progress Bar -->
              <div class="w-full bg-gray-100 dark:bg-gray-800 rounded-full h-2.5 mb-5 overflow-hidden">
                <div id="job-progress-bar" class="bg-[#0029ff] h-2.5 rounded-full w-0 transition-[width] duration-300"></div>
              </div>

              <!-- Live Scoring logs -->
              <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">Live Scoring Log Feed</h3>
              <div id="job-log-area" class="bg-gray-950 dark:bg-black text-gray-300 dark:text-gray-450 font-mono text-xs p-4 rounded-xl max-h-56 overflow-y-auto space-y-2 shadow-inner border border-gray-900 dark:border-gray-950 scroll-smooth">
                <!-- Log entries dynamically load here -->
              </div>
            </div>

          </div>

          <!-- Right Column (1/3 width): Processing Queue -->
          <div class="lg:col-span-1 space-y-6">
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
              <div class="flex items-center justify-between mb-5">
                <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Scoring Queue</h3>
                <span id="queue-count" class="px-2 py-0.5 text-xs font-bold bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full">0</span>
              </div>
              
              <div id="queue-container" class="space-y-3.5 min-h-[120px] flex flex-col justify-start">
                <!-- Queue cards slide in here -->
                <p id="queue-empty" class="text-sm text-gray-400 dark:text-gray-500 text-center py-10 my-auto">
                  No jobs currently in the scoring queue
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Client-side script -->
    <script src="/js/upload.js" nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>"></script>
    <%- include('partials/footer') %>
  </body>
</html>
