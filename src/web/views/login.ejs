<!doctype html>
<html lang="en" class="">
  <head>
    <%- include('partials/head') %>
    <title>Sign In — ICP Profiler</title>
    <style>
      .auth-bg {
        background-color: #030712;
        background-image:
          radial-gradient(at 0% 0%, hsla(244, 50%, 15%, 0.4) 0px, transparent 50%),
          radial-gradient(at 100% 100%, hsla(224, 50%, 10%, 0.3) 0px, transparent 50%),
          linear-gradient(to bottom right, #030712, #0b0f19);
      }
      .auth-grid {
        background-size: 40px 40px;
        background-image:
          linear-gradient(to right, rgba(0, 41, 255, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 41, 255, 0.04) 1px, transparent 1px);
      }
      .card-glass {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .animate-fadeUp { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-8px); }
      }
      .animate-float { animation: float 4s ease-in-out infinite; }
      .input-field {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        color: #f1f5f9;
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .input-field:focus {
        outline: none;
        border-color: #0029ff;
        box-shadow: 0 0 0 3px rgba(0, 41, 255, 0.15);
      }
      .input-field::placeholder { color: rgba(148, 163, 184, 0.5); }
      .btn-primary {
        background: linear-gradient(135deg, #0029ff, #0018c0);
        color: white;
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      }
      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 24px rgba(0, 41, 255, 0.35);
        opacity: 0.95;
      }
      .btn-primary:active { transform: translateY(0); }
      .btn-demo {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: #cbd5e1;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .btn-demo:hover {
        background: rgba(0, 41, 255, 0.12);
        border-color: rgba(0, 41, 255, 0.4);
        color: #fff;
      }
    </style>
  </head>
  <body class="auth-bg min-h-screen flex items-center justify-center p-4">
    <div class="absolute inset-0 auth-grid pointer-events-none"></div>

    <!-- Decorative blobs -->
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-[#0029ff]/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative w-full max-w-md animate-fadeUp">
      <!-- Logo -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img src="/luxury-hero.png" alt="ICP Profiler" class="w-10 h-10 rounded-xl object-cover animate-float shadow-lg shadow-[#0029ff]/20" />
          <span class="text-2xl font-bold text-white tracking-tight">ICP Profiler</span>
        </a>
        <p class="mt-2 text-slate-400 text-sm">AI-powered lead intelligence</p>
      </div>

      <div class="card-glass rounded-2xl p-8 shadow-2xl">
        <h1 class="text-xl font-bold text-white mb-1">Welcome back</h1>
        <p class="text-slate-400 text-sm mb-6">Sign in to your account to continue</p>

        <% if (error) { %>
          <div class="mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/auth/login" id="login-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="space-y-4">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Email address</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="you@company.com"
                class="input-field w-full px-4 py-2.5 rounded-xl text-sm"
              />
            </div>

            <div>
              <label for="password" class="block text-sm font-medium text-slate-300 mb-1.5">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                placeholder="••••••••"
                class="input-field w-full px-4 py-2.5 rounded-xl text-sm"
              />
            </div>
          </div>

          <button type="submit" id="sign-in-btn" class="btn-primary mt-6 w-full py-2.5 px-4 rounded-xl text-sm font-semibold">
            Sign in
          </button>
        </form>

        <div class="my-5 flex items-center gap-3">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="text-slate-500 text-xs">or</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>

        <!-- Demo login -->
        <form method="POST" action="/auth/login" id="demo-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="email" value="demo@example.com" />
          <input type="hidden" name="password" value="password" />
          <button type="submit" id="demo-login-btn" class="btn-demo w-full py-2.5 px-4 rounded-xl text-sm font-semibold flex items-center justify-center gap-2">
            <svg class="w-4 h-4 text-[#0029ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Try the demo
            <span class="text-slate-500 text-xs font-normal">(demo@example.com)</span>
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-slate-500">
          Don't have an account?
          <a href="/auth/register" class="text-[#0029ff] hover:text-blue-400 font-medium transition-colors">Create one</a>
        </p>
      </div>

      <p class="mt-6 text-center text-xs text-slate-600">
        &copy; <%= new Date().getFullYear() %> ICP Profiler. Built with ❤️ as a portfolio project.
      </p>
    </div>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
      // Flash focus on email field
      document.getElementById('email')?.focus();
    </script>
  </body>
</html>
