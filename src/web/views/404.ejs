<!doctype html>
<html lang="en" class="">
  <head>
    <%- include('partials/head') %>
    <title>404 — Page Not Found | ICP Profiler</title>
    <style>
      .auth-bg {
        background-color: #030712;
        background-image:
          radial-gradient(at 20% 20%, hsla(244, 50%, 15%, 0.4) 0px, transparent 50%),
          radial-gradient(at 80% 80%, hsla(224, 50%, 10%, 0.3) 0px, transparent 50%),
          linear-gradient(to bottom right, #030712, #0b0f19);
      }
      .auth-grid {
        background-size: 40px 40px;
        background-image:
          linear-gradient(to right, rgba(0, 41, 255, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 41, 255, 0.03) 1px, transparent 1px);
      }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .animate-fadeUp { animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-10px); }
      }
      .animate-float { animation: float 5s ease-in-out infinite; }
      .glitch {
        background: linear-gradient(135deg, #0029ff, #7c3aed, #0029ff);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: shimmer 3s linear infinite;
      }
      @keyframes shimmer {
        to { background-position: 200% center; }
      }
    </style>
  </head>
  <body class="auth-bg min-h-screen flex items-center justify-center p-4">
    <div class="absolute inset-0 auth-grid pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/4 w-72 h-72 bg-[#0029ff]/8 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/3 right-1/4 w-56 h-56 bg-violet-500/8 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative text-center animate-fadeUp max-w-lg">
      <div class="animate-float mb-6">
        <img src="/luxury-hero.png" alt="ICP Profiler" class="w-16 h-16 rounded-2xl object-cover mx-auto shadow-2xl shadow-[#0029ff]/30" />
      </div>

      <h1 class="text-8xl font-black glitch mb-4">404</h1>
      <h2 class="text-2xl font-bold text-white mb-3">Page not found</h2>
      <p class="text-slate-400 text-base mb-8 leading-relaxed">
        This lead doesn't exist in our system — or it was scored as <span class="text-red-400 font-semibold">NOT FIT</span>.<br/>
        Let's get you back to scoring real ones.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" id="go-home-btn"
           class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white"
           style="background: linear-gradient(135deg, #0029ff, #0018c0); box-shadow: 0 4px 16px rgba(0,41,255,0.3); transition: transform 0.15s, box-shadow 0.15s;"
           onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(0,41,255,0.4)'"
           onmouseout="this.style.transform='';this.style.boxShadow='0 4px 16px rgba(0,41,255,0.3)'">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Go home
        </a>
        <a href="/history" id="view-history-btn"
           class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-slate-300"
           style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); transition: background 0.2s, color 0.2s;"
           onmouseover="this.style.background='rgba(0,41,255,0.12)';this.style.color='#fff'"
           onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.color=''">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          View history
        </a>
      </div>
    </div>
  </body>
</html>
