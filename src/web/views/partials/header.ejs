<meta name="csrf-token" content="<%= csrfToken %>">

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  @keyframes pulse-slow {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .animate-pulse-slow {
    animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes slideDown {
    from {
      max-height: 0;
      opacity: 0;
    }
    to {
      max-height: 300px;
      opacity: 1;
    }
  }
  #mobile-menu:not(.hidden) {
    animation: slideDown 300ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    overflow: hidden;
  }
</style>

<header class="sticky top-0 z-50 bg-white dark:bg-gray-950 shadow-sm w-full border-b border-gray-100 dark:border-gray-900 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Left: Brand (logo + text) -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2.5 font-bold text-xl text-gray-900 dark:text-white group">
          <img src="/luxury-hero.png" alt="ICP Profiler Logo" class="w-6 h-6 rounded-md object-cover animate-float" />
          <span class="tracking-tight hover:text-[#0029ff] dark:hover:text-blue-400 transition-colors duration-200">ICP Profiler</span>
        </a>
      </div>

      <!-- Middle: Navigation Links (Desktop) -->
      <div class="hidden md:block">
        <nav aria-label="Main Navigation" class="flex items-center gap-6">
          <a href="/" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200 hover:underline decoration-[#0029ff] text-sm font-medium" data-nav-link>Home</a>
          <a href="/history" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200 hover:underline decoration-[#0029ff] text-sm font-medium" data-nav-link>History</a>
          <a href="/config" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200 hover:underline decoration-[#0029ff] text-sm font-medium" data-nav-link>Config</a>
          <a href="/personas" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200 hover:underline decoration-[#0029ff] text-sm font-medium" data-nav-link>Personas</a>
          <a href="/email-settings" class="text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-200 hover:underline decoration-[#0029ff] text-sm font-medium" data-nav-link>Email Settings</a>
        </nav>
      </div>

      <!-- Right: Active Persona Pill, Theme Toggle, & Hamburger Menu Button -->
      <div class="flex items-center gap-4">
        <!-- Active Persona Pill Badge -->
        <div class="relative group">
          <div class="px-3.5 py-1.5 text-xs font-semibold text-[#0029ff] bg-[#0029ff]/5 dark:bg-blue-950/40 dark:text-blue-400 border border-[#0029ff]/10 dark:border-blue-900/30 rounded-full animate-pulse-slow cursor-default flex items-center gap-1.5" aria-describedby="persona-tooltip">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0029ff]" aria-hidden="true"></span>
            <span>Active Persona: <span class="max-w-[100px] sm:max-w-[150px] truncate inline-block align-bottom font-bold"><%= activePersonaName %></span></span>
          </div>
          <!-- Tooltip -->
          <div id="persona-tooltip" role="tooltip" class="absolute right-0 mt-2 hidden group-hover:block bg-gray-900 dark:bg-gray-800 text-white text-xs rounded-lg py-2 px-3 whitespace-nowrap shadow-lg z-50 border border-gray-800 dark:border-gray-700 transition-opacity duration-150">
            Current Profile: <%= activePersonaName %>
          </div>
        </div>

        <!-- User info + Logout (shown when authenticated) -->
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
        <div class="hidden md:flex items-center gap-2">
          <span class="text-xs text-gray-500 dark:text-gray-400 max-w-[120px] truncate" title="<%= typeof userEmail !== 'undefined' ? userEmail : '' %>"><%= typeof userEmail !== 'undefined' ? userEmail : '' %></span>
          <a href="/auth/logout" id="logout-btn" class="text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-red-500 dark:hover:text-red-400 transition-colors px-2 py-1 rounded-lg hover:bg-red-50 dark:hover:bg-red-950/30" aria-label="Sign out">Sign out</a>
        </div>
        <% } %>

        <!-- Theme Toggle Button -->
        <button id="theme-toggle" type="button" class="p-2 rounded-xl text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-900 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#0029ff]/30" aria-label="Toggle theme">
          <!-- Dark mode icon (moon) - visible when document is dark -->
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
          <!-- Light mode icon (sun) - visible when document is light -->
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.46 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.41 8.49a1 1 0 11-1.41 1.415l-.707-.707a1 1 0 111.414-1.414l.707.707zM3.75 9a.75.75 0 000 1.5h1a.75.75 0 000-1.5h-1z" clip-rule="evenodd"></path>
          </svg>
        </button>

        <!-- Hamburger Menu Button (Mobile) -->
        <button id="mobile-menu-button" type="button" class="md:hidden inline-flex items-center justify-center p-2.5 rounded-lg text-gray-500 hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-[#0029ff]" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg id="hamburger-icon" class="block h-5.5 w-5.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Close icon -->
          <svg id="close-icon" class="hidden h-5.5 w-5.5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 dark:border-gray-900 bg-white dark:bg-gray-950">
    <nav aria-label="Mobile Navigation" class="px-4 py-3 space-y-1.5">
      <a href="/" class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-[#0029ff] dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-all duration-200 hover:underline decoration-[#0029ff]" data-nav-link>Home</a>
      <a href="/history" class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-[#0029ff] dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-all duration-200 hover:underline decoration-[#0029ff]" data-nav-link>History</a>
      <a href="/config" class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-[#0029ff] dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-all duration-200 hover:underline decoration-[#0029ff]" data-nav-link>Config</a>
      <a href="/personas" class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-[#0029ff] dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-all duration-200 hover:underline decoration-[#0029ff]" data-nav-link>Personas</a>
      <a href="/email-settings" class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-[#0029ff] dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-900 transition-all duration-200 hover:underline decoration-[#0029ff]" data-nav-link>Email Settings</a>
      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <div class="pt-2 border-t border-gray-100 dark:border-gray-900">
        <p class="px-3 py-1 text-xs text-gray-400 dark:text-gray-500 truncate"><%= typeof userEmail !== 'undefined' ? userEmail : '' %></p>
        <a href="/auth/logout" class="block w-full text-left px-3 py-2 rounded-lg text-sm font-semibold text-red-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 transition-all duration-200">Sign out</a>
      </div>
      <% } %>
    </nav>
  </div>
</header>

<script src="/js/header.js" nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>"></script>

<!-- Floating Toast Container for Notifications -->
<div id="toast-container" class="fixed top-28 right-6 z-50 max-w-xs w-auto space-y-2 pointer-events-none"></div>

