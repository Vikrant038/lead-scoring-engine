<!doctype html>
<html lang="en">
  <head><%- include('partials/head') %></head>
  <body class="bg-gray-50 text-gray-900" data-persona-id="<%= personaId %>">
    <%- include('partials/nav') %>
    <main class="max-w-3xl mx-auto p-6">
      <h1 class="text-2xl font-semibold mb-1">Edit persona</h1>
      <p class="text-sm text-gray-500 mb-4"><%= personaId %></p>

      <textarea
        id="persona-json"
        class="w-full h-96 font-mono text-sm border border-gray-300 rounded-lg p-3 bg-white"
        spellcheck="false"
      ><%= personaJson %></textarea>

      <div class="mt-4 flex items-center gap-3">
        <button id="save-btn" class="px-4 py-2 rounded text-white" style="background-color: #0029ff">
          Save
        </button>
        <a href="/personas" class="px-4 py-2 rounded border border-gray-300 bg-white">Back</a>
        <span id="status" class="text-sm" role="status"></span>
      </div>
    </main>
    <script src="/js/persona-edit.js"></script>
  </body>
</html>
