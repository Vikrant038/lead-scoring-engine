# Lead Scoring Engine — environment variables (SEC-01/02). Copy to .env and fill in.

# --- AI (optional; system degrades to rule-based logic without a key) ---
AI_PROVIDER=groq            # none | groq | gemini | openai | youcom | ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUCOM_API_KEY=
SERPER_API_KEY=

# --- Vercel Deployment (optional) ---
VERCEL_API_KEY=

# --- Web server ---
PORT=3000
SESSION_SECRET=             # REQUIRED in production (SEC-03). Use a long random string.

# --- Logging ---
LOG_LEVEL=info              # debug | info | warn | error

# --- Node ---
NODE_ENV=development

# --- Better Auth (Phase 1) ---
BETTER_AUTH_SECRET=         # REQUIRED: random 64-char string for token encryption/signing
BETTER_AUTH_URL=http://localhost:3000

# --- Social Login / OAuth (optional; buttons hide automatically if keys missing) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

