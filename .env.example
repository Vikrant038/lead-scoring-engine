# Lead Scoring Engine — environment variables (SEC-01/02). Copy to .env and fill in.

# --- AI (optional; system degrades to rule-based logic without a key) ---
AI_PROVIDER=groq            # none | groq | gemini | openai | youcom | ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENAI_API_KEY=
YOUCOM_API_KEY=
SERPER_API_KEY=

# --- Local Ollama (optional; no API key needed) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# --- Web server ---
PORT=3000
SESSION_SECRET=             # REQUIRED in production (SEC-03). Use a long random string.

# --- Logging ---
LOG_LEVEL=info              # debug | info | warn | error

# --- Node ---
NODE_ENV=development

# --- Better Auth (Phase 1) ---
BETTER_AUTH_SECRET=         # REQUIRED: random 64-char string for token encryption/signing
BETTER_AUTH_URL=http://localhost:3000

# --- Social Login / OAuth (Optional: GitHub & Google/Gmail Registration) ---
# GitHub Developer Settings -> OAuth Apps -> Authorization callback URL:
# Local: http://localhost:3000/api/auth/callback/github | Prod: https://<your-domain>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> Authorized redirect URIs:
# Local: http://localhost:3000/api/auth/callback/google | Prod: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

